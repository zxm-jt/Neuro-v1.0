# 统一换行符规则，避免 Windows / macOS / Linux 协作时出现整文件假改动
* text=auto eol=lf

# Windows 批处理必须保持 CRLF，否则可能无法执行
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制资源不做换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.mp4  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.npz  binary
*.onnx binary
*.zip  binary
